                    "rightValue": "",
                    "operator": {
                      "type": "string",
                      "operation": "notEmpty",
                      "singleValue": true
                    }
                  },
                  {
                    "id": "d1000000-0000-4000-8000-000000000004",
                    "leftValue": "={{\n  (\n    $('Execute Workflow Trigger').first().json.action === 'direct_ticket' &&\n    $('Get Support Request').first().json.fields.status === 'NEW'\n  ) ||\n  (\n    $('Execute Workflow Trigger').first().json.action === 'confirmed_escalation' &&\n    $('Get Support Request').first().json.fields.status === 'AWAITING_ESCALATION'\n  )\n}}",
