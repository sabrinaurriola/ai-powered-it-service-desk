                    "id": "d1000000-0000-4000-8000-000000000001",
                    "leftValue": "={{\n  !!$('Find Existing Ticket').first().json.id &&\n  ['direct_ticket', 'confirmed_escalation'].includes(\n    $('Execute Workflow Trigger').first().json.action\n  )\n}}",
                    "rightValue": "",
